<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#1F2636" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#1B2230" />
            <stroke android:width="2dp" android:color="#0284C7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#161B26" />
            <stroke android:width="1dp" android:color="#262F42" />
        </shape>
    </item>
</selector>
