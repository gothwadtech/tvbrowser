<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#222F43" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="#38BDF8" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A2536" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#0284C7" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#172336" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#0284C7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#131924" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#1E293B" />
        </shape>
    </item>
</selector>
