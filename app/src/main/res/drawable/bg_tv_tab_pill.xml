<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused (TV remote highlighted) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/day_night_focus_bg" />
            <stroke android:width="2dp" android:color="@color/day_night_focus_stroke" />
        </shape>
    </item>

    <!-- Activated (Currently Selected Tab) -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/selected_link_bkg" />
            <stroke android:width="1.5dp" android:color="@color/day_night_focus_stroke" />
        </shape>
    </item>

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/day_night_focus_bg" />
            <stroke android:width="2dp" android:color="@color/day_night_focus_stroke" />
        </shape>
    </item>

    <!-- Default Inactive -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/day_night_surface_subtle" />
            <stroke android:width="1dp" android:color="@color/day_night_divider" />
        </shape>
    </item>
</selector>
