<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused and Activated (Selected & focused by TV remote) -->
    <item android:state_focused="true" android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/day_night_focus_bg" />
            <stroke android:width="2.5dp" android:color="@color/day_night_focus_stroke" />
        </shape>
    </item>

    <!-- Focused only (Hovered/Navigated by D-pad) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/day_night_focus_bg" />
            <stroke android:width="2.5dp" android:color="@color/day_night_focus_stroke" />
        </shape>
    </item>

    <!-- Activated (Selected tab when browsing settings on the right panel) -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#1A3B82F6" />
            <stroke android:width="1.5dp" android:color="@color/progressbar_tint" />
        </shape>
    </item>

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/day_night_focus_bg" />
        </shape>
    </item>

    <!-- Normal Inactive State -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
