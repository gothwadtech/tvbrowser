<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llFileManagerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_tv_right_sidebar"
    android:fitsSystemWindows="true"
    android:clipChildren="false">

    <!-- Top MT-Style Header Bar with Back, Home, History (< >), Path Bar, Refresh, New File, New Folder -->
    <RelativeLayout
        android:id="@+id/rlHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/top_bar_background"
        android:elevation="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="false">

            <!-- 1. Exit / Back to Browser Button -->
            <ImageButton
                android:id="@+id/ibBack"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/navigate_back"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/back_icon_selector" />

            <!-- 2. Home Button (Storage Root) -->
            <ImageButton
                android:id="@+id/ibHomeRoot"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Internal Storage /"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_home_grey_900_24dp" />

            <!-- 3. History Back (<) Navigation Button -->
            <ImageButton
                android:id="@+id/ibNavHistoryBack"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="History Back"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_arrow_back_grey_900_24dp" />

            <!-- 4. History Forward (>) Navigation Button -->
            <ImageButton
                android:id="@+id/ibNavHistoryForward"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="History Forward"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_arrow_forward_grey_900_24dp" />

            <!-- 5. Address / Path Breadcrumb Omnibox Bar -->
            <LinearLayout
                android:id="@+id/llPathContainer"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/chrome_omnibox_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/ivPathTypeIcon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_folder"
                    android:tint="@color/progressbar_tint"
                    android:contentDescription="@null" />

                <!-- Clickable Breadcrumb Chips Container -->
                <HorizontalScrollView
                    android:id="@+id/hsvBreadcrumbs"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:scrollbars="none"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/llBreadcrumbs"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Static Path text (used for non-folder categories) -->
                <TextView
                    android:id="@+id/tvCurrentPath"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:ellipsize="start"
                    android:singleLine="true"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="/storage/emulated/0/Download" />

                <TextView
                    android:id="@+id/tvItemCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gray_badge_bg"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="0 items"
                    android:textColor="@color/day_night_text_secondary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Expandable Search Bar Container -->
            <LinearLayout
                android:id="@+id/llSearchBar"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/chrome_omnibox_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/progressbar_tint"
                    android:contentDescription="Search" />

                <EditText
                    android:id="@+id/etSearchQuery"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@null"
                    android:hint="Search files..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textColorHint="@color/day_night_disabled_icon_color"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/ibClearSearch"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/button_bg_selector"
                    android:src="@drawable/ic_close"
                    android:tint="@color/day_night_disabled_icon_color"
                    android:contentDescription="Clear Search"
                    android:padding="4dp" />
            </LinearLayout>

            <!-- Search Toggle Button -->
            <ImageButton
                android:id="@+id/ibSearch"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Search"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_search" />

            <!-- Sort Options Button -->
            <ImageButton
                android:id="@+id/ibSort"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Sort by"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_sort_white" />

            <!-- Grid / List Switcher Button -->
            <ImageButton
                android:id="@+id/ibViewMode"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Toggle Grid / List View"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_view_grid" />

            <!-- Multi-Selection Toggle Button -->
            <ImageButton
                android:id="@+id/ibSelectMode"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Multi-Select"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_select_all" />

            <!-- Paste Button (Shown when clipboard has items) -->
            <ImageButton
                android:id="@+id/ibPaste"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Paste"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/progressbar_tint"
                android:visibility="gone"
                android:src="@drawable/ic_content_paste" />

            <!-- Refresh / Reload Icon -->
            <ImageButton
                android:id="@+id/ibRefresh"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Refresh"
                android:focusable="true"
                android:padding="5.5dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_refresh_grey_900_24dp" />

            <!-- Create New File Icon -->
            <ImageButton
                android:id="@+id/ibNewFile"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="New File"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_file_new" />

            <!-- Create New Folder Icon -->
            <ImageButton
                android:id="@+id/ibNewFolder"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="New Folder"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_folder_new" />

        </LinearLayout>
    </RelativeLayout>

    <!-- Main Content: Left Dual Separation Panel + Right File List Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Categories & Storage Separation Panel (MT Manager Style with SVGs) -->
        <ScrollView
            android:layout_width="168dp"
            android:layout_height="match_parent"
            android:background="@color/day_night_surface_subtle"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <!-- Storage Locations Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingBottom="3dp"
                    android:text="PARTITIONS"
                    android:textColor="@color/day_night_text_secondary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <!-- 1. Internal Storage (ROM) -->
                <LinearLayout
                    android:id="@+id/btnCatStorage"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/sidebar_nav_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:id="@+id/ivCatStorageIcon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/ic_storage_internal"
                        android:tint="@color/progressbar_tint"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvCatStorageText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:text="Internal (ROM)"
                        android:textColor="@color/day_night_text_color_contrast"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Dynamic USB / OTG Partitions Container -->
                <LinearLayout
                    android:id="@+id/llUsbPartitions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 2. Root Directory ( / ) -->
                <LinearLayout
                    android:id="@+id/btnCatSystemRoot"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/sidebar_nav_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:id="@+id/ivCatSystemRootIcon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/ic_root_partition"
                        android:tint="@color/day_night_text_secondary"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvCatSystemRootText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:text="Root Directory (/)"
                        android:textColor="@color/day_night_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- 3. Downloads Shortcut -->
                <LinearLayout
                    android:id="@+id/btnCatDownloads"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/sidebar_nav_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:id="@+id/ivCatDownloadsIcon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/ic_file_download_grey_900"
                        android:tint="@color/day_night_text_secondary"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvCatDownloadsText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:text="Downloads"
                        android:textColor="@color/day_night_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="5dp"
                    android:background="@color/day_night_divider" />

                <!-- Categories Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingBottom="3dp"
                    android:text="CATEGORIES"
                    android:textColor="@color/day_night_text_secondary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <!-- 4. Recent Files -->
                <LinearLayout
                    android:id="@+id/btnCatRecents"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/sidebar_nav_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:id="@+id/ivCatRecentsIcon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/ic_recents_time"
                        android:tint="@color/day_night_text_secondary"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvCatRecentsText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:text="Recent Files"
                        android:textColor="@color/day_night_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- 5. APKs -->
                <LinearLayout
                    android:id="@+id/btnCatApks"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/sidebar_nav_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:id="@+id/ivCatApksIcon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/ic_file_apk"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvCatApksText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:text="Apps &amp; APKs"
                        android:textColor="@color/day_night_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- 6. Videos -->
                <LinearLayout
                    android:id="@+id/btnCatVideos"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/sidebar_nav_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:id="@+id/ivCatVideosIcon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/ic_file_video"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvCatVideosText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:text="Videos"
                        android:textColor="@color/day_night_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- 7. Audio -->
                <LinearLayout
                    android:id="@+id/btnCatAudio"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/sidebar_nav_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:id="@+id/ivCatAudioIcon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/ic_file_audio"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvCatAudioText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:text="Audio"
                        android:textColor="@color/day_night_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- 8. Images -->
                <LinearLayout
                    android:id="@+id/btnCatImages"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/sidebar_nav_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:id="@+id/ivCatImagesIcon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/ic_file_image"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvCatImagesText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:text="Images"
                        android:textColor="@color/day_night_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <!-- 9. Documents -->
                <LinearLayout
                    android:id="@+id/btnCatDocs"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/sidebar_nav_button_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:id="@+id/ivCatDocsIcon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/ic_file_doc"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvCatDocsText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:text="Documents"
                        android:textColor="@color/day_night_text_secondary"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="5dp"
                    android:background="@color/day_night_divider" />

                <!-- Memory & Storage Manager Sidebar Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingBottom="3dp"
                    android:text="MEMORY &amp; STORAGE"
                    android:textColor="@color/day_night_text_secondary"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/llSidebarStorageManager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/sidebar_item_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_storage_pie"
                            android:tint="@color/progressbar_tint"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="Memory Info"
                            android:textColor="@color/day_night_text_color_contrast"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbSidebarStorage"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="4dp"
                        android:max="100"
                        android:progress="45"
                        android:progressTint="@color/progressbar_tint" />

                    <TextView
                        android:id="@+id/tvSidebarStorageStats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Storage Details"
                        android:textColor="@color/day_night_text_secondary"
                        android:textSize="9.5sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Right Content Area -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="2dp">

            <!-- Files Grid / List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFiles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="2dp"
                android:paddingBottom="20dp" />

            <!-- Empty Directory View -->
            <LinearLayout
                android:id="@+id/llEmptyView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_folder"
                    android:alpha="0.4"
                    android:tint="@color/day_night_disabled_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvEmptyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="No files found"
                    android:textColor="@color/day_night_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Permission Prompt View for Android 11+ / Missing Permissions -->
            <LinearLayout
                android:id="@+id/llPermissionPrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_storage_internal"
                    android:tint="@color/progressbar_tint"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvPermissionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Full Storage Access Required"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPermissionDesc"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Android requires 'All Files Access' permission to browse and manage storage. Please enable it in system settings."
                    android:textColor="@color/day_night_text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnGrantPermission"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/button_bg_selector"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Enable in Settings"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Loading Spinner -->
            <ProgressBar
                android:id="@+id/pbLoading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/progressbar_tint"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Multi-Select Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/llMultiSelectBar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@color/top_bar_background"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSelectedCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 selected"
            android:textColor="@color/day_night_text_color_contrast"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_bg_selector"
            android:text="Select All"
            android:textColor="@color/day_night_text_color_contrast"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btnBatchCopy"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_bg_selector"
            android:text="Copy"
            android:textColor="@color/day_night_text_color_contrast"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btnBatchCut"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_bg_selector"
            android:text="Cut"
            android:textColor="@color/day_night_text_color_contrast"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btnBatchDelete"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_bg_selector"
            android:text="Delete"
            android:textColor="#FF5252"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btnBatchShare"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_bg_selector"
            android:text="Share"
            android:textColor="@color/day_night_text_color_contrast"
            android:textSize="11sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btnCancelSelect"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/button_bg_selector"
            android:text="Done"
            android:textColor="@color/progressbar_tint"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
