<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rlRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.main.MainActivity"
    android:fitsSystemWindows="true"
    tools:deviceIds="tv"
    android:clipChildren="false">

    <com.gothwad.tvbrowser.widgets.cursor.CursorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/flWebViewContainer" />

    <com.gothwad.tvbrowser.activity.main.view.home.NativeHomeView
        android:id="@+id/vNativeHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ProgressBar
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:id="@+id/progressBar"
        android:progressTint="@color/progressbar_tint"
        android:visibility="visible" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/rlActionBar"
        android:background="@color/top_bar_background"
        android:elevation="4dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="3dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Unified Single Header Layer in Exact Requested Sequence:
             1. Home
             2. Search Bar (with Mic inside)
             3. Plus (+) Icon
             4. Tab Icon (Count Badge)
             5. Back
             6. Forward
             7. Reload
             8. Download Icon
             9. Bookmark Icon
             10. Settings Icon (3-dots)
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="false">

            <!-- 1. Home -->
            <ImageButton
                android:id="@+id/ibHome"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/navigate_home"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_home_grey_900_24dp" />

            <!-- 2. Search Bar (with Mic inside) -->
            <com.gothwad.tvbrowser.activity.main.view.ActionBar
                android:id="@+id/vActionBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp" />

            <!-- 3. Plus Icon (New Tab) -->
            <ImageButton
                android:id="@+id/ibNewTab"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/open_new_tab"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_add" />

            <!-- 4. Tab Icon (Chrome-style Tab Switcher Rounded Square Badge with Tab Count) -->
            <FrameLayout
                android:id="@+id/flTabsSwitcher"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Tabs Overview"
                android:focusable="true"
                android:clickable="true">

                <TextView
                    android:id="@+id/tvTabCountBadge"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="@drawable/chrome_tab_count_badge"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- 5. Back -->
            <ImageButton
                android:id="@+id/ibBack"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/navigate_back"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/back_icon_selector" />

            <!-- 6. Forward -->
            <ImageButton
                android:id="@+id/ibForward"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/navigate_forward"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/forward_icon_selector" />

            <!-- 7. Reload -->
            <ImageButton
                android:id="@+id/ibRefresh"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="@string/refresh_page"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_refresh_grey_900_24dp" />

            <!-- 8. Download Icon -->
            <ImageButton
                android:id="@+id/ibDownloads"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Downloads"
                android:focusable="true"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_file_download_grey_900" />

            <!-- 9. Bookmark Icon -->
            <ImageButton
                android:id="@+id/ibBookmarks"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Bookmarks"
                android:focusable="true"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_star_border_grey_900_36dp" />

            <!-- 10. Settings Icon (3-dots) -->
            <ImageButton
                android:id="@+id/ibSettings"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="More Options"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_more_vert" />

        </LinearLayout>
    </RelativeLayout>

    <ImageView
        android:id="@+id/ivMiniatures"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/llMiniaturePlaceholder"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"
        android:layout_below="@+id/rlActionBar"
        android:layout_alignWithParentIfMissing="true"
        android:visibility="gone">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_baseline_add_box_24"
            android:layout_marginEnd="20dp"
            tools:ignore="ContentDescription" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:text="@string/open_a_new_tab_here" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llBottomPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentBottom="true"
        android:visibility="gone" />
    
    <com.gothwad.tvbrowser.activity.main.view.CursorMenuView
        android:id="@+id/vCursorMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        />

    <ProgressBar
        android:id="@+id/progressBarGeneric"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        />

</RelativeLayout>
