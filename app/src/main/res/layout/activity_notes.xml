<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llNotesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/day_night_background_color"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Unified Top Bar: Switches between Normal Mode and Multi-Select Mode -->
    <RelativeLayout
        android:id="@+id/rlNotesHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/top_bar_background"
        android:elevation="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 1. NORMAL HEADER MODE -->
        <LinearLayout
            android:id="@+id/llNormalHeader"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="false">

            <!-- Back to Browser -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/back_icon_selector" />

            <!-- All Notes (Active) Tab -->
            <LinearLayout
                android:id="@+id/btnTabAllNotes"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/sidebar_nav_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/ivTabAllNotesIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_nav_notes"
                    android:tint="@color/progressbar_tint"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvTabAllNotesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Notes"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Archived Notes Tab -->
            <LinearLayout
                android:id="@+id/btnTabArchived"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/sidebar_nav_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/ivTabArchivedIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_archive"
                    android:tint="@color/day_night_text_secondary"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvTabArchivedText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Archived"
                    android:textColor="@color/day_night_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Search Notes Omnibox -->
            <LinearLayout
                android:id="@+id/llSearchContainer"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:background="@drawable/chrome_omnibox_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/day_night_text_secondary"
                    android:contentDescription="@null" />

                <EditText
                    android:id="@+id/etSearchNotes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@null"
                    android:hint="Search notes &amp; ideas..."
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textColorHint="@color/day_night_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvNotesCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gray_badge_bg"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="0 notes"
                    android:textColor="@color/day_night_text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Clipboard History Shortcut -->
            <ImageButton
                android:id="@+id/btnClipboardHistory"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Clipboard History"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_nav_clipboard" />

            <!-- Select Mode Toggle Button -->
            <ImageButton
                android:id="@+id/btnToggleSelect"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Select Notes"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_select_all" />

            <!-- Add Note Button -->
            <ImageButton
                android:id="@+id/btnAddNote"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="New Note"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_note_add" />

        </LinearLayout>

        <!-- 2. MULTI-SELECTION HEADER MODE (Visible when selection is active) -->
        <LinearLayout
            android:id="@+id/llSelectionHeader"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            android:clipChildren="false">

            <!-- Close / Cancel Selection Mode -->
            <ImageButton
                android:id="@+id/btnCloseSelection"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/button_bg_selector"
                android:contentDescription="Cancel Selection"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:tint="@color/day_night_icon_color"
                android:src="@drawable/ic_close_grey_900_24dp" />

            <!-- Selection Count Status -->
            <TextView
                android:id="@+id/tvSelectionCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="0 selected"
                android:textColor="@color/day_night_text_color_contrast"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Select All / Deselect All Button -->
            <Button
                android:id="@+id/btnSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/sidebar_nav_button_bg"
                android:drawableStart="@drawable/ic_select_all"
                android:drawablePadding="6dp"
                android:drawableTint="@color/day_night_icon_color"
                android:focusable="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Select All"
                android:textAllCaps="false"
                android:textColor="@color/day_night_text_color_contrast"
                android:textSize="11.5sp" />

            <!-- Archive / Unarchive Button -->
            <Button
                android:id="@+id/btnArchiveSelected"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/sidebar_nav_button_bg"
                android:drawableStart="@drawable/ic_archive"
                android:drawablePadding="6dp"
                android:drawableTint="@color/day_night_icon_color"
                android:focusable="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Archive"
                android:textAllCaps="false"
                android:textColor="@color/day_night_text_color_contrast"
                android:textSize="11.5sp" />

            <!-- Delete Selected Button -->
            <Button
                android:id="@+id/btnDeleteSelected"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/sidebar_nav_button_bg"
                android:drawableStart="@drawable/ic_delete"
                android:drawablePadding="6dp"
                android:drawableTint="#EF4444"
                android:focusable="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Delete"
                android:textAllCaps="false"
                android:textColor="#EF4444"
                android:textSize="11.5sp"
                android:textStyle="bold" />

        </LinearLayout>
    </RelativeLayout>

    <!-- Main Content Area: Notes Grid + Empty View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Notes Grid List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvNotes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/llEmptyNotesView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivEmptyNotesIcon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@drawable/ic_nav_notes"
                android:alpha="0.4"
                android:tint="@color/day_night_disabled_icon_color"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvEmptyNotesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="No notes found"
                android:textColor="@color/day_night_text_color_contrast"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmptyNotesSubtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Click the '+' button in the top bar to create a note"
                android:textColor="@color/day_night_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
