<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/day_night_background_color"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/top_bar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/button_bg_selector"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/back_icon_selector" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="✏️ TV Notes"
            android:textColor="@color/day_night_text_color_contrast"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Search Input -->
        <EditText
            android:id="@+id/etSearchNotes"
            android:layout_width="220dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/chrome_omnibox_bg"
            android:hint="Search notes..."
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/day_night_text_color_contrast"
            android:textColorHint="@color/day_night_text_secondary"
            android:textSize="13sp" />

        <!-- Add Note Button -->
        <Button
            android:id="@+id/btnAddNote"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/button_bg_selector"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="➕ New Note"
            android:textColor="@color/day_night_text_color_contrast"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Notes Grid List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp" />

</LinearLayout>
