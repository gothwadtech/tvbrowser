<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/day_night_surface_color"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header with Type & Meta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDetailCategoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_tab_bg_selector"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/progressbar_tint"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="LINK" />

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/day_night_text_color_contrast"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Copied Item" />

        <TextView
            android:id="@+id/tvDetailTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/day_night_text_secondary"
            android:textSize="12sp"
            tools:text="Aug 19, 10:30 AM" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/day_night_divider" />

    <!-- Full Content Display Card -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@color/day_night_surface_subtle"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvDetailFullText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/day_night_text_color_contrast"
            android:textSize="14sp"
            android:textIsSelectable="true"
            tools:text="Copied text content..." />
    </ScrollView>

    <!-- Stats Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvDetailCharWordStats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/day_night_text_secondary"
            android:textSize="12sp"
            tools:text="Length: 142 characters" />

        <TextView
            android:id="@+id/tvDetailCopyCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#10B981"
            android:textSize="12sp"
            tools:text="Copied 3 times" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="14dp"
        android:background="@color/day_night_divider" />

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Copy Action -->
        <Button
            android:id="@+id/btnDetailCopy"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/button_bg_selector"
            android:focusable="true"
            android:text="📋 Copy Again"
            android:textColor="@color/progressbar_tint"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Open in Browser Action -->
        <Button
            android:id="@+id/btnDetailOpenUrl"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/button_bg_selector"
            android:focusable="true"
            android:text="🌐 Open in Browser"
            android:textColor="#10B981"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Delete -->
        <Button
            android:id="@+id/btnDetailDelete"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/button_bg_selector"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="🗑️ Delete"
            android:textColor="#EF4444"
            android:textSize="13sp" />

        <!-- Close -->
        <Button
            android:id="@+id/btnDetailClose"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/button_bg_selector"
            android:focusable="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Close"
            android:textColor="@color/day_night_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
