<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="@color/day_night_background_color">

    <!-- Top Settings Header Bar -->
    <RelativeLayout
        android:id="@+id/rlSettingsHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/top_bar_background"
        android:elevation="4dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_gothwad_logo"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/settings"
                android:textColor="@color/day_night_text_color_contrast"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/tv_accent_badge_bg"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="TV Configuration Hub"
                android:textColor="@color/progressbar_tint"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/ibCloseSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/button_bg_selector"
            android:contentDescription="Close"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close_grey_900_24dp"
            android:tint="@color/day_night_icon_color" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/day_night_divider" />

    <!-- TV Split Body: Left Categories Navigation Rail + Right Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Left Categories Navigation Rail -->
        <ScrollView
            android:id="@+id/svSettingsTabs"
            android:layout_width="230dp"
            android:layout_height="match_parent"
            android:background="@color/day_night_surface_subtle"
            android:paddingTop="14dp"
            android:paddingBottom="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llSettingsTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <!-- 1. General & Theme -->
                <Button
                    android:id="@+id/btnTabGeneral"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/settings_tab_item_bg"
                    android:drawableStart="@drawable/ic_settings_general"
                    android:drawableTint="@color/progressbar_tint"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp"
                    android:text="General &amp; Theme"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- 2. Privacy & PIN Lock -->
                <Button
                    android:id="@+id/btnTabPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/settings_tab_item_bg"
                    android:drawableStart="@drawable/ic_settings_privacy"
                    android:drawableTint="@color/day_night_text_secondary"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp"
                    android:text="Privacy &amp; PIN Lock"
                    android:textColor="@color/day_night_text_secondary"
                    android:textSize="13sp" />

                <!-- 3. Browser & Search Engine -->
                <Button
                    android:id="@+id/btnTabBrowser"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/settings_tab_item_bg"
                    android:drawableStart="@drawable/ic_settings_browser"
                    android:drawableTint="@color/day_night_text_secondary"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp"
                    android:text="Browser &amp; Search"
                    android:textColor="@color/day_night_text_secondary"
                    android:textSize="13sp" />

                <!-- 4. Tools & AdBlock -->
                <Button
                    android:id="@+id/btnTabTools"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/settings_tab_item_bg"
                    android:drawableStart="@drawable/ic_settings_tools"
                    android:drawableTint="@color/day_night_text_secondary"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp"
                    android:text="Tools &amp; AdBlock"
                    android:textColor="@color/day_night_text_secondary"
                    android:textSize="13sp" />

                <!-- 5. TV Remote & Keys -->
                <Button
                    android:id="@+id/btnTabRemote"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/settings_tab_item_bg"
                    android:drawableStart="@drawable/ic_settings_remote"
                    android:drawableTint="@color/day_night_text_secondary"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp"
                    android:text="TV Remote &amp; Keys"
                    android:textColor="@color/day_night_text_secondary"
                    android:textSize="13sp" />

                <!-- 6. Keyboard & Mouse (Dedicated Hardware Section) -->
                <Button
                    android:id="@+id/btnTabKeyboardMouse"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/settings_tab_item_bg"
                    android:drawableStart="@drawable/ic_settings_keyboard_mouse"
                    android:drawableTint="@color/day_night_text_secondary"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp"
                    android:text="Keyboard &amp; Mouse"
                    android:textColor="@color/day_night_text_secondary"
                    android:textSize="13sp" />

                <!-- 7. Shortcuts & Hotkeys (Dedicated PC Shortcuts Section) -->
                <Button
                    android:id="@+id/btnTabShortcuts"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/settings_tab_item_bg"
                    android:drawableStart="@drawable/ic_settings_shortcuts"
                    android:drawableTint="@color/day_night_text_secondary"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp"
                    android:text="Shortcuts &amp; Hotkeys"
                    android:textColor="@color/day_night_text_secondary"
                    android:textSize="13sp" />

                <!-- 8. About & Gothwad Tech -->
                <Button
                    android:id="@+id/btnTabAbout"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/settings_tab_item_bg"
                    android:drawableStart="@drawable/ic_settings_about"
                    android:drawableTint="@color/day_night_text_secondary"
                    android:drawablePadding="12dp"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp"
                    android:text="About Gothwad Tech"
                    android:textColor="@color/day_night_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/day_night_divider" />

        <!-- Right Content Area -->
        <FrameLayout
            android:id="@+id/flTabsContent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/day_night_background_color">
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
