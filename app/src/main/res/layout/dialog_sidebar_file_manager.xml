<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/flFileManagerSidebarRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <View
        android:id="@+id/vFileManagerBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false" />

    <!-- Right Side Drawer Panel -->
    <LinearLayout
        android:id="@+id/llFileManagerPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_tv_right_sidebar"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <!-- Top Header with Back Button, Title, Path/Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/btnFmBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_tv_side_back_btn"
                android:clickable="true"
                android:contentDescription="Close File Manager"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back_grey_900_24dp"
                android:tint="@color/selector_tv_side_back_icon" />

            <TextView
                android:id="@+id/tvFmTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="File Manager"
                android:textColor="@color/day_night_text_color_contrast"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnFmHome"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tv_side_back_btn"
                android:clickable="true"
                android:contentDescription="Home storage"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home_grey_900_24dp"
                android:tint="@color/day_night_text_color_contrast" />

            <ImageButton
                android:id="@+id/btnFmFolderUp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_tv_side_back_btn"
                android:clickable="true"
                android:contentDescription="Up directory"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_folder_up"
                android:tint="@color/day_night_text_color_contrast" />
        </LinearLayout>

        <!-- Quick Shortcut Tabs Row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFmCatStorage"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill_button"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Storage"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnFmCatDownloads"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill_button"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Downloads"
                    android:textAllCaps="false"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnFmCatApks"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill_button"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="APKs"
                    android:textAllCaps="false"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnFmCatMedia"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_pill_button"
                    android:focusable="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Media"
                    android:textAllCaps="false"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Current Path Breadcrumb -->
        <TextView
            android:id="@+id/tvFmCurrentPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/key_badge_bg"
            android:ellipsize="start"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="/storage/emulated/0"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <!-- Content List / Empty / Loading View -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFmFiles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:focusable="true"
                android:scrollbars="vertical" />

            <ProgressBar
                android:id="@+id/pbFmLoading"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llFmEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_folder"
                    android:alpha="0.4"
                    android:tint="@color/day_night_text_color_contrast"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Folder is Empty"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
