<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/clipboard_row_bg_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- Category / Type Icon Badge -->
    <FrameLayout
        android:id="@+id/flTypeBadge"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/round_icon_bg">

        <ImageView
            android:id="@+id/ivTypeIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_nav_clipboard"
            android:tint="@color/day_night_icon_color"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Main Information Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Title & Pin indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPinIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="📌"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/day_night_text_color_contrast"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="https://google.com" />
        </LinearLayout>

        <!-- Preview Text (Single Row) -->
        <TextView
            android:id="@+id/tvPreviewText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/day_night_text_color"
            android:textSize="13sp"
            tools:text="Copied text preview..." />

        <!-- Metadata & Stats Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCategoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/settings_tab_bg_selector"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textColor="@color/progressbar_tint"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="TEXT" />

            <TextView
                android:id="@+id/tvCharCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/day_night_text_secondary"
                android:textSize="11sp"
                tools:text="48 chars" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="•"
                android:textColor="@color/day_night_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/day_night_text_secondary"
                android:textSize="11sp"
                tools:text="Aug 19, 10:30 AM" />

            <TextView
                android:id="@+id/tvCopyCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#10B981"
                android:textSize="11sp"
                tools:text="• Copied 3x" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Action Icon Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Quick Re-Copy Icon Button -->
        <ImageButton
            android:id="@+id/btnRowCopy"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/button_bg_selector"
            android:contentDescription="Copy to clipboard"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_clipboard"
            android:tint="@color/day_night_icon_color" />

        <!-- Delete Icon Button -->
        <ImageButton
            android:id="@+id/btnRowDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/button_bg_selector"
            android:contentDescription="Delete from history"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete"
            android:tint="#EF4444" />
    </LinearLayout>

</LinearLayout>
