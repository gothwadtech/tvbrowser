<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llFileCardRoot"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="1dp"
    android:layout_marginBottom="1dp"
    android:background="@drawable/sidebar_item_bg"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="1dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Multi-selection Checkbox -->
    <ImageView
        android:id="@+id/ivSelectCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_check_box_outline"
        android:tint="@color/day_night_disabled_icon_color"
        android:visibility="gone"
        android:contentDescription="Select" />

    <!-- File/Folder Icon -->
    <FrameLayout
        android:id="@+id/flFileIconContainer"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/round_icon_bg">

        <ImageView
            android:id="@+id/ivFileIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_folder"
            tools:src="@drawable/ic_folder" />
    </FrameLayout>

    <!-- File/Folder Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/day_night_text_color_contrast"
            android:textSize="12.5sp"
            android:textStyle="bold"
            tools:text="Download_App_Update.apk" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFileSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/day_night_text_secondary"
                android:textSize="10.5sp"
                tools:text="24.5 MB" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="•"
                android:textColor="@color/day_night_text_secondary"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/tvFileDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/day_night_text_secondary"
                android:textSize="10.5sp"
                tools:text="Aug 19, 2026" />
        </LinearLayout>
    </LinearLayout>

    <!-- Folder Navigation Right Arrow Indicator / Action Badge -->
    <ImageView
        android:id="@+id/ivFolderArrow"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="2dp"
        android:scaleType="centerInside"
        android:tint="@color/day_night_disabled_icon_color"
        android:src="@drawable/ic_keyboard_arrow_right_grey_900_18dp"
        android:contentDescription="Open folder"
        android:visibility="visible" />

    <!-- 3-Dots More Options Button -->
    <ImageButton
        android:id="@+id/ibItemMore"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="2dp"
        android:background="@drawable/button_bg_selector"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/day_night_disabled_icon_color"
        android:contentDescription="Options"
        android:focusable="false"
        android:padding="5dp"
        android:scaleType="fitCenter" />

</LinearLayout>
