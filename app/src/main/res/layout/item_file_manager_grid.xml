<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llFileGridRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:background="@drawable/sidebar_item_bg"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="1dp"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Top Row: Selection Checkbox & More button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="22dp">

        <ImageView
            android:id="@+id/ivSelectCheck"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_check_box_outline"
            android:tint="@color/day_night_disabled_icon_color"
            android:visibility="gone"
            android:contentDescription="Select" />

        <ImageButton
            android:id="@+id/ibItemMore"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/button_bg_selector"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/day_night_disabled_icon_color"
            android:contentDescription="Options"
            android:focusable="false"
            android:padding="3dp"
            android:scaleType="fitCenter" />
    </RelativeLayout>

    <!-- Center Icon / Thumbnail Container -->
    <FrameLayout
        android:id="@+id/flFileIconContainer"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/round_icon_bg">

        <ImageView
            android:id="@+id/ivFileIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_folder"
            tools:src="@drawable/ic_folder" />
    </FrameLayout>

    <!-- File Name -->
    <TextView
        android:id="@+id/tvFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/day_night_text_color_contrast"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="Video_recording.mp4" />

    <!-- File Size / Date -->
    <TextView
        android:id="@+id/tvFileSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/day_night_text_secondary"
        android:textSize="9.5sp"
        tools:text="14.2 MB" />

</LinearLayout>
