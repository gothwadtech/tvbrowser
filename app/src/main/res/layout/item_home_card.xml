<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llShortcutRoot"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:layout_margin="3dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="@drawable/tv_shortcut_card_selector">

    <!-- Squircle Icon Box -->
    <FrameLayout
        android:id="@+id/flIconCircle"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/tv_shortcut_icon_bg">

        <!-- Official Vector Logo Drawable -->
        <ImageView
            android:id="@+id/ivIconDrawable"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:visibility="gone" />

        <!-- 1-Letter Fallback / + Add Text -->
        <TextView
            android:id="@+id/tvIconText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/day_night_text_color_contrast"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="G" />
    </FrameLayout>

    <!-- Shortcut Title & Domain Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvShortcutTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/day_night_text_color_contrast"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="Google" />

        <TextView
            android:id="@+id/tvShortcutDomain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/day_night_text_secondary"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="google.com" />
    </LinearLayout>

</LinearLayout>
