<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llNoteCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/settings_card_bg"
    android:clickable="true"
    android:elevation="3dp"
    android:focusable="true"
    android:minHeight="140dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Row: Pin and Date -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvNoteDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:textColor="@color/day_night_text_secondary"
            android:textSize="11sp"
            tools:text="Aug 18, 2026 · 07:30 PM" />

        <ImageView
            android:id="@+id/ivPin"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_star_border_grey_900_36dp"
            android:tint="@color/day_night_icon_color"
            android:visibility="gone"
            android:contentDescription="Pinned" />
    </RelativeLayout>

    <!-- Note Title -->
    <TextView
        android:id="@+id/tvNoteTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/day_night_text_color_contrast"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Meeting Notes" />

    <!-- Note Content Preview -->
    <TextView
        android:id="@+id/tvNoteContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="4"
        android:textColor="@color/day_night_text_color"
        android:textSize="13sp"
        tools:text="Here is the detailed content of the note describing everything that was discussed..." />

</LinearLayout>
