<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llNoteCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/settings_card_bg"
    android:clickable="true"
    android:elevation="3dp"
    android:focusable="true"
    android:minHeight="130dp"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Selection Checkbox / Pin / Date / Archive badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Checkbox visible in selection mode -->
            <ImageView
                android:id="@+id/ivCheckSelect"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_check_box_outline"
                android:tint="@color/day_night_icon_color"
                android:visibility="gone"
                android:contentDescription="Select" />

            <TextView
                android:id="@+id/tvNoteDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/day_night_text_secondary"
                android:textSize="10.5sp"
                tools:text="Aug 25, 2026 · 07:30 PM" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivArchiveBadge"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_archive"
                android:tint="@color/day_night_text_secondary"
                android:visibility="gone"
                android:contentDescription="Archived" />

            <ImageView
                android:id="@+id/ivPin"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_pin"
                android:tint="@color/progressbar_tint"
                android:visibility="gone"
                android:contentDescription="Pinned" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Note Title -->
    <TextView
        android:id="@+id/tvNoteTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/day_night_text_color_contrast"
        android:textSize="14.5sp"
        android:textStyle="bold"
        tools:text="Meeting Notes" />

    <!-- Note Content Preview -->
    <TextView
        android:id="@+id/tvNoteContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="4"
        android:textColor="@color/day_night_text_color"
        android:textSize="12sp"
        tools:text="Here is the detailed content of the note describing everything that was discussed..." />

</LinearLayout>
