<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llClipboardItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_sleek"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Row: Snippet Icon + Time + Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_content_copy"
            android:tint="#38BDF8"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvClipboardTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Just now"
            android:textColor="#64748B"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btnClipboardDelete"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_tv_side_back_btn"
            android:clickable="true"
            android:contentDescription="Delete clip"
            android:focusable="true"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete_grey_400_24dp"
            android:tint="@color/day_night_text_color_contrast" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvClipboardText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="https://github.com/google/ai-studio"
        android:textColor="@color/day_night_text_color_contrast"
        android:textSize="12sp" />
</LinearLayout>
