<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llNoteItemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_sleek"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Row: Title + Pin + Delete -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/vNoteColorStrip"
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:background="#38BDF8" />

        <TextView
            android:id="@+id/tvNoteTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Meeting Notes"
            android:textColor="@color/day_night_text_color_contrast"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnNoteDelete"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_tv_side_back_btn"
            android:clickable="true"
            android:contentDescription="Delete note"
            android:focusable="true"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete_grey_400_24dp"
            android:tint="@color/day_night_text_color_contrast" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNoteContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Remember to review the design guidelines and test remote navigation..."
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvNoteDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Today, 2:30 PM"
        android:textColor="#64748B"
        android:textSize="10sp" />
</LinearLayout>
