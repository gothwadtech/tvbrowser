<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llTabRowCardRoot"
    android:layout_width="220dp"
    android:layout_height="160dp"
    android:layout_marginEnd="14dp"
    android:background="@drawable/bg_card_tab_selector"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="8dp"
    android:elevation="3dp">

    <!-- Top Tab Header: Favicon + Title + Pin/Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <ImageView
            android:id="@+id/ivTabFavicon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tab_default_favicon"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvTabTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tab Title"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/ibCloseTab"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@null"
            android:contentDescription="Close Tab"
            android:focusable="false"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close_grey_900_24dp"
            android:tint="#94A3B8" />
    </LinearLayout>

    <!-- Thumbnail Preview / Web Content -->
    <FrameLayout
        android:id="@+id/flThumbnailContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#161B26">

        <ImageView
            android:id="@+id/ivTabPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvActiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/tv_accent_badge_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="ACTIVE"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom URL Bar inside card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_tab_default_favicon"
            android:tint="#94A3B8"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvTabDomain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="google.com"
            android:textColor="#94A3B8"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
