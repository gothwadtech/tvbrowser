<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llChromeTabRoot"
    android:layout_width="170dp"
    android:layout_height="32dp"
    android:layout_marginEnd="2dp"
    android:background="@drawable/bg_chrome_tab_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/ivTabFavicon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="Tab Icon"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_tab_default_favicon" />

    <TextView
        android:id="@+id/tvTabTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="New Tab"
        android:textColor="@color/day_night_text_color_contrast"
        android:textSize="12sp"
        tools:text="Google Search" />

    <ImageButton
        android:id="@+id/ibTabClose"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_chrome_close_btn"
        android:contentDescription="Close Tab"
        android:focusable="true"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close_grey_900_24dp"
        android:tint="@color/day_night_icon_color" />

</LinearLayout>
