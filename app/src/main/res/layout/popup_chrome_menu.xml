<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llChromeMenuRoot"
    android:layout_width="230dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/menu_popup_bg"
    android:paddingTop="6dp"
    android:paddingBottom="8dp"
    android:elevation="12dp"
    android:focusable="true">

    <!-- Top Quick Action Icons Row (App Lock, Page Info, Refresh) -->
    <LinearLayout
        android:id="@+id/llTopActionsRow"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- 1. App Lock / Security PIN -->
        <ImageButton
            android:id="@+id/btnMenuAppLock"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/menu_item_selector"
            android:contentDescription="App Lock Security"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_lock_security"
            android:tint="@color/day_night_icon_color" />

        <!-- 2. Page Info & SSL Security Details -->
        <ImageButton
            android:id="@+id/btnMenuPageInfo"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/menu_item_selector"
            android:contentDescription="Site Info"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu_info"
            android:tint="@color/day_night_icon_color" />

        <!-- 3. Refresh Page -->
        <ImageButton
            android:id="@+id/btnMenuRefresh"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/menu_item_selector"
            android:contentDescription="Refresh page"
            android:focusable="true"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh_grey_900_24dp"
            android:tint="@color/day_night_icon_color" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:background="@color/day_night_divider" />

    <!-- Scrollable Items Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="440dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- 1. New Tab -->
            <LinearLayout
                android:id="@+id/btnMenuNewTab"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_menu_new_tab"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="New tab"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 2. New Incognito Tab -->
            <LinearLayout
                android:id="@+id/btnMenuIncognito"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_incognito"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="New Incognito tab"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:background="@color/day_night_divider" />

            <!-- 3. TV Notes (Tools moved to menu) -->
            <LinearLayout
                android:id="@+id/btnMenuNotes"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_notes"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="TV Notes"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 4. Clipboard Manager -->
            <LinearLayout
                android:id="@+id/btnMenuClipboard"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_clipboard"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Clipboard Manager"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 5. File Manager -->
            <LinearLayout
                android:id="@+id/btnMenuFileManager"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_files"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="File Manager"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:background="@color/day_night_divider" />

            <!-- 6. History -->
            <LinearLayout
                android:id="@+id/btnMenuHistory"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_history_grey_900_36dp"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="History"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 7. Share... -->
            <LinearLayout
                android:id="@+id/btnMenuShare"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_menu_share"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Share..."
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 8. Desktop site -->
            <RelativeLayout
                android:id="@+id/btnMenuDesktop"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/ivDesktopIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_menu_desktop"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/ivDesktopIcon"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:text="Desktop site"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbDesktopSite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="false"
                    android:focusable="false"
                    android:buttonTint="@color/day_night_list_focused_background_color" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"
                android:background="@color/day_night_divider" />

            <!-- 9. Settings -->
            <LinearLayout
                android:id="@+id/btnMenuSettings"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_settings_grey_900_24dp"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Settings"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 10. Help & feedback -->
            <LinearLayout
                android:id="@+id/btnMenuHelp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/menu_item_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_menu_help"
                    android:tint="@color/day_night_icon_color"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Help &amp; feedback"
                    android:textColor="@color/day_night_text_color_contrast"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
