<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llVirtualRemoteRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_virtual_remote"
    android:orientation="vertical"
    android:padding="8dp"
    android:elevation="30dp"
    android:focusable="false"
    android:focusableInTouchMode="false">

    <!-- Row 1: BACK (Col 1), UP (Col 2), MOVE (Col 3) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:focusable="false"
        android:focusableInTouchMode="false">

        <!-- 1. BACK Button -->
        <FrameLayout
            android:id="@+id/btnDpadBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_virtual_remote_btn"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Back"
                android:tint="#FFFFFF"
                android:src="@drawable/ic_arrow_back_grey_900_24dp" />
        </FrameLayout>

        <!-- 2. UP Button -->
        <FrameLayout
            android:id="@+id/btnDpadUp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_virtual_remote_btn"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="▲"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 3. Move / Drag Button -->
        <FrameLayout
            android:id="@+id/btnMoveMode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_virtual_remote_btn"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <ImageView
                android:id="@+id/ivMoveIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Drag to Move"
                android:tint="#FFFFFF"
                android:src="@drawable/ic_move_remote" />
        </FrameLayout>
    </LinearLayout>

    <!-- Row 2: LEFT (Col 1), OK (Col 2), RIGHT (Col 3) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:focusable="false"
        android:focusableInTouchMode="false">

        <!-- 4. LEFT Button -->
        <FrameLayout
            android:id="@+id/btnDpadLeft"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_virtual_remote_btn"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="◀"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 5. OK Center Button -->
        <FrameLayout
            android:id="@+id/btnDpadCenter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_virtual_remote_btn"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="OK"
                android:textColor="#0494f4"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 6. RIGHT Button -->
        <FrameLayout
            android:id="@+id/btnDpadRight"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_virtual_remote_btn"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="▶"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- Row 3: HOME (Col 1), DOWN (Col 2), MENU (Col 3) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:focusable="false"
        android:focusableInTouchMode="false">

        <!-- 7. HOME Button -->
        <FrameLayout
            android:id="@+id/btnDpadHome"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_virtual_remote_btn"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Home"
                android:tint="#FFFFFF"
                android:src="@drawable/ic_home_grey_900_24dp" />
        </FrameLayout>

        <!-- 8. DOWN Button -->
        <FrameLayout
            android:id="@+id/btnDpadDown"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_virtual_remote_btn"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="▼"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 9. MENU / Settings Button -->
        <FrameLayout
            android:id="@+id/btnDpadMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="3dp"
            android:background="@drawable/bg_virtual_remote_btn"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Menu"
                android:tint="#FFFFFF"
                android:src="@drawable/ic_settings_grey_900_24dp" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
