<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.BrowserAppBase" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowEnterTransition">@android:transition/fade</item>
        <item name="android:windowExitTransition">@android:transition/fade</item>
        <item name="android:windowSharedElementExitTransition">@android:transition/move</item>
        <item name="android:windowSharedElementEnterTransition">@android:transition/move</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/top_bar_background</item>
        <item name="android:navigationBarColor">@color/top_bar_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="Theme.BrowserApp" parent="Theme.BrowserAppBase">
    </style>

    <!-- NEW THEMES FOR RIGHT AND LEFT FULL-HEIGHT SIDEBARS -->
    <style name="Theme.SidebarRight" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowAnimationStyle">@style/SideDrawerAnimation</item>
    </style>

    <style name="Theme.SidebarLeft" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowAnimationStyle">@style/SideDrawerLeftAnimation</item>
    </style>

    <style name="SettingsDialog" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/day_night_background_color</item>
        <item name="android:statusBarColor">@color/top_bar_background</item>
        <item name="android:navigationBarColor">@color/top_bar_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
        <item name="android:windowSoftInputMode">stateUnspecified|adjustPan</item>
    </style>
    <style name="BottomTabsDialog" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
    <style name="TvFullScreenDialog" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
    <style name="SideDrawerAnimation">
        <item name="android:windowEnterAnimation">@anim/right_menu_in_anim</item>
        <item name="android:windowExitAnimation">@anim/right_menu_out_anim</item>
    </style>

    <style name="SideDrawerLeftAnimation">
        <item name="android:windowEnterAnimation">@anim/left_menu_in_anim</item>
        <item name="android:windowExitAnimation">@anim/left_menu_out_anim</item>
    </style>

    <style name="TvSideDrawerDialog" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowAnimationStyle">@style/SideDrawerLeftAnimation</item>
    </style>

    <style name="TvSettingsDrawerDialog" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowAnimationStyle">@style/SideDrawerAnimation</item>
    </style>
</resources>
